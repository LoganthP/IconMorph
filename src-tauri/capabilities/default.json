{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the IconMorph main window. Only the IconMorph commands, native open/save dialogs and reveal-in-folder are allowed; the frontend has no direct filesystem access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    "allow-platform-info",
    "allow-startup-report",
    "allow-list-desktop",
    "allow-list-folder",
    "allow-inspect-item",
    "allow-preview-icon",
    "allow-apply-icon",
    "allow-apply-batch",
    "allow-cancel-batch",
    "allow-restore-icon",
    "allow-restore-all",
    "allow-forget-item",
    "allow-history",
    "allow-customized-items",
    "allow-icon-preview",
    "allow-export-icon",
    "allow-gif-info",
    "allow-gif-thumbnails",
    "allow-performance-stats",
    "allow-cleanup-icons",
    "allow-get-setting",
    "allow-set-setting",
    "allow-release-memory",
    "allow-designs-for",
    "allow-reapply-design",
    "allow-create-snapshot",
    "allow-list-snapshots",
    "allow-delete-snapshot",
    "allow-restore-snapshot",
    "allow-source-palette",
    "allow-image-thumbnail",
    "allow-pick-target",
    "allow-live-status",
    "allow-live-enable",
    "allow-live-disable",
    "allow-live-set-autostart",
    "allow-live-run"
  ]
}