{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IconMorph",
  "version": "0.2.1",
  "identifier": "com.loganth.iconmorph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "IconMorph",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "IconMorph contributors",
    "copyright": "MIT License",
    "license": "MIT",
    "shortDescription": "Native desktop icon personalization",
    "longDescription": "Customize folders and shortcuts with characters, emojis, GIF frames and images. Icons are applied natively, so IconMorph does not need to keep running.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libglib2.0-bin"
        ]
      },
      "rpm": {
        "depends": [
          "glib2"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}